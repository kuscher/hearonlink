#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# HearOn Link dev helper: build, install and drive the app on a Googlebook (or phone) over adb.
#
#   ./hol build [release]     assemble the debug (or release) APK
#   ./hol test                core tests on this machine (JUnit, no device)
#   ./hol app                 build, install and launch (only when you say so: it takes focus)
#   ./hol install | launch | stop | uninstall
#   ./hol debug CMD...        test hooks (DebugReceiver.kt): state, connect, disconnect, send HEX,
#                             mode off|tr|ad|no, control ID V.., log on|off, head SECS, wait SECS, onboarded [false]
#   ./hol head [SECS] [OUT]   record raw head-motion frames (wear the AirPods and nod/shake)
#   ./hol render KIND W H DPI DARK OUT   KIND home|page:NOISE|demo|demo:yes|demo:no|away|onboarding|panel
#   ./hol pull FILE [OUT]     copy a file from the app's cache (calibration-last.txt = the last calibration's raw frames)
#   ./hol logs [N]            HearOn Link's log lines
#   ./hol sh CMD...           adb shell on the device
#   ./hol idle                seconds since the last user input on the device, and the focused window
#
# adb's server listens on a Unix socket (VSCodeBook's), never tcp:5037: the Linux terminal
# forwards every TCP port to Android, where any app could reach it.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
PKG=io.github.kuscher.hearonlink
APK=app/build/outputs/apk/debug/app-debug.apk
ENVF="$HOME/.config/vscodebook/android.env"
[ -f "$ENVF" ] && . "$ENVF"
export ADB_SERVER_SOCKET=${ADB_SERVER_SOCKET:-localfilesystem:$HOME/.local/state/vscodebook/adb.sock}
TMP=${XDG_RUNTIME_DIR:-/tmp}

serial() { cat "$HOME/.config/vscodebook/adb-serial" 2>/dev/null; }
connect() {
  local s; s="$(serial)"
  if [ -n "$s" ] && adb -s "$s" shell true >/dev/null 2>&1; then echo "$s"; return; fi
  vscodebook android connect </dev/null >/dev/null 2>&1 || true
  serial
}
A() { adb -s "$(connect)" "$@"; }
dbg() {
  A shell "am broadcast --user current -f 0x20 -a $PKG.DEBUG -p $PKG --es c '$*'" >/dev/null
  sleep "${WAIT:-0.6}"
  A shell "logcat -d -s HearOnLink:I" | grep "debug $1 ->" | tail -1 | sed 's/.*-> //'
}

build() { if [ "${1:-}" = release ]; then ./gradlew :app:assembleRelease --console=plain -q; else ./gradlew :app:assembleDebug --console=plain -q; fi; }

install() {
  local s; s="$(connect)"
  adb -s "$s" shell settings put global verifier_verify_adb_installs 0
  adb -s "$s" install -r "${1:-$APK}" || { adb -s "$s" shell settings put global verifier_verify_adb_installs 1; exit 1; }
  adb -s "$s" shell settings put global verifier_verify_adb_installs 1
}

cmd=${1:-help}; shift || true
case "$cmd" in
  build) build "${1:-}" ;;
  test) ./gradlew :core:test --console=plain -q ;;
  install) install "${1:-}" ;;
  launch) A shell am start --user current -n "$PKG/.ui.MainActivity" >/dev/null ;;
  stop) A shell am force-stop "$PKG" ;;
  uninstall) A shell pm uninstall "$PKG" || true ;;
  app) build && install && A shell am start --user current -n "$PKG/.ui.MainActivity" >/dev/null ;;
  debug) A logcat -c; dbg "$@" ;;
  head)
    secs=${1:-8}; out=${2:-$TMP/hearon-head.txt}
    A logcat -c; WAIT=$((secs + 2)) dbg head "$secs"
    u=$(A shell am get-current-user | tr -d '\r')
    A exec-out run-as "$PKG" --user "$u" cat cache/head.txt > "$out" && echo "$out ($(wc -l < "$out") frames)" ;;
  render)  # ./hol render KIND W H DPI DARK OUT.png — the real UI on a private virtual display (debug builds)
    A logcat -c; res=$(WAIT=4 dbg render "$1 $2 $3 $4 $5"); echo "$res" | grep -q '^/' || { echo "render: $res"; exit 1; }
    u=$(A shell am get-current-user | tr -d '\r')
    A exec-out run-as "$PKG" --user "$u" cat cache/render.png > "$6" && echo "$6" ;;
  pull)  # ./hol pull FILE [OUT]: a file from the app's cache dir (e.g. calibration-last.txt)
    u=$(A shell am get-current-user | tr -d '\r'); out=${2:-$TMP/hearon-$1}
    A exec-out run-as "$PKG" --user "$u" cat "cache/$1" > "$out" && echo "$out" ;;
  logs) A shell "logcat -d -s HearOnLink:* AndroidRuntime:E" | tail -n "${1:-40}" ;;
  sh) A shell "$@" ;;
  idle)
    A shell dumpsys power | grep -E "lastUserActivityTime=|mWakefulness=" | head -2
    A shell "dumpsys window | grep -E 'mCurrentFocus' | head -1" ;;
  *) sed -n '3,16p' "$0" ;;
esac
