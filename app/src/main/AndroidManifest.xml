<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the AirPods (classic Bluetooth) and read the case's adverts. Never used for location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Companion device: start when the AirPods connect, without a battery-optimisation exemption. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- Phones only, optional: answer or decline a ringing call with a nod or a shake. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- "Open an app" (a stem press or head gesture): the apps with a launcher icon, to pick one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".HearOnApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.HearOn">

        <!-- A desktop window: resizable down to a phone-sized column; resizing, and plugging in a
             keyboard or mouse, re-lays the UI out without restarting the activity. One window only
             (singleTask): it shows one pair of AirPods. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <layout
                android:defaultWidth="1180dp"
                android:defaultHeight="800dp"
                android:gravity="center"
                android:minWidth="360dp"
                android:minHeight="480dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press on the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- The tile's small panel: battery, listening mode, conversation awareness. -->
        <activity
            android:name=".ui.PanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="io.github.kuscher.hearonlink.panel"
            android:theme="@style/Theme.HearOn.Panel" />

        <service
            android:name=".link.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".link.PresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <service
            android:name=".system.ModeTile"
            android:exported="true"
            android:icon="@drawable/ic_mode_nc"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <receiver android:name=".link.BtReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".system.Actions" android:exported="false" />
        <receiver android:name=".link.NearbyReceiver" android:exported="false" />

        <receiver android:name=".system.BatteryWidgetReceiver" android:exported="true" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_widget" />
        </receiver>

        <!-- Test hooks for adb (./hol debug …). Only callers holding DUMP (the shell) can send these. -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.kuscher.hearonlink.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
